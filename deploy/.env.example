# Copy to deploy/.env and fill in. Used by:
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d
#
# Anything left COMMENTED OUT runs faked/disabled — DESIGN.md §3: "with zero
# config the whole daemon runs and self-validates on fakes." The vars marked
# REQUIRED below are required only because opsclaw-hindsight (the memory
# backend) itself refuses to boot without them — the daemon's own live-mode
# gate is HINDSIGHT_URL being reachable at all, not any specific model.
#
# Optional credentials are commented rather than left blank on purpose: a
# bare `NAME=` still reaches the container, and until v0.1.1 the daemon read
# a present-but-empty credential as a configured one, left fakes mode, and
# then crash-looped demanding the rest of a live setup. Uncomment a line only
# when you are giving it a real value.

# --- Image version ----------------------------------------------------------
# Which ghcr.io/dcprevere/opsclaw tag to run. Defaults to `latest`, which
# moves on every release — pin an immutable vX.Y.Z in production so an
# upgrade is always a decision you made.
# OPSCLAW_VERSION=v0.3.0

# --- Hindsight's own LLM (its internal retain/reflect extraction) ----------
# ALL FOUR ARE REQUIRED, including the key — Hindsight raises "LLM API key is
# required" and crash-loops without it. Any OpenAI-compatible endpoint works;
# OpenRouter is a good single choice if you don't want a second provider
# account. Compose refuses to start if any of these is blank, which is the
# intended failure: a clear message here beats a crash-loop later.
# OpenAI directly works too (verified with Hindsight 1.2.0 and gpt-6.1-sol
# and gpt-6-luna). Luna is about a twentieth of Sol's price, and memory
# extraction doesn't need more:
#   HINDSIGHT_LLM_MODEL=gpt-6-luna
#   HINDSIGHT_LLM_BASE_URL=https://api.openai.com/v1
# Memories are written in English unless you set:
#   HINDSIGHT_LLM_OUTPUT_LANGUAGE=English
HINDSIGHT_LLM_PROVIDER=openai
HINDSIGHT_LLM_MODEL=openai/gpt-4o-mini
HINDSIGHT_LLM_BASE_URL=https://openrouter.ai/api/v1
HINDSIGHT_LLM_API_KEY=

# --- opsclaw's own LLM (shipped default: OpenRouter only, DESIGN.md §7.13) -
# Commented out, not blank: uncomment BOTH or neither. A key with no models
# refuses to boot on purpose (config.rs validate(): "there is no sensible
# cross-vendor default and every call would fail").
# OPENROUTER_API_KEY=sk-or-v1-...
# Comma-separated ordered model list — OpenRouter's server-side fallback.
# OPSCLAW_MODELS=anthropic/claude-sonnet-4.5,openai/gpt-4o-mini
#
# OpenAI directly instead of OpenRouter: put the key here and, in
# config.toml, set
#   [llm]
#   api_key = "env:OPENAI_API_KEY"
#   base_url = "https://api.openai.com/v1"
#   models = ["gpt-6.1-sol"]
# Only the first model is used: fallbacks are an OpenRouter feature.
# OPENAI_API_KEY=sk-...

# --- Scan cadence ------------------------------------------------------------
# Minutes between scheduled scans of each target (default 30). Each scan is a
# full LLM investigation, so this is the main spend lever.
# OPSCLAW_SCAN_INTERVAL_MINUTES=120

# --- Memory (Hindsight) -----------------------------------------------------
# Defaults to the bundled opsclaw-hindsight service; only override if
# pointing at an external Hindsight instance instead.
# HINDSIGHT_URL=http://opsclaw-hindsight:8888
# HINDSIGHT_TOKEN=

# --- Telegram channel (optional) --------------------------------------------
# TELEGRAM_BOT_TOKEN=123456:ABC-...

# --- External dead-man heartbeat (DESIGN.md §4) -----------------------------
# A standard feature in every placement; mandatory for the Helm/in-cluster
# install (deploy/helm/values.yaml: deadmanUrl). Point it at healthchecks.io,
# a PagerDuty heartbeat, or any webhook outside this host's own failure
# domain, so silence itself pages when the whole daemon dies.
# OPSCLAW_DEADMAN_URL=https://hc-ping.com/<uuid>

RUST_LOG=opsclaw=info,tower_http=info
# Set to json for one structured object per log line; omit for human output.
# OPSCLAW_LOG_FORMAT=json
